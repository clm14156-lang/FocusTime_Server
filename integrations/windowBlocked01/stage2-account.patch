+    private static CloudTokens Tokens() => new("Bearer", new string('A', 64), DateTimeOffset.UtcNow.AddMinutes(-1),
+        new string('B', 64), DateTimeOffset.UtcNow.AddDays(10), Guid.NewGuid(), Guid.NewGuid(),
+        new(Guid.NewGuid(), "person@example.test", true));
+
+    [Fact]
+    public async Task RefreshResponseLost_RestartUsesSameRequestId_AndConcurrentRestoresRotateOnce()
+    {
+        var store = new MemoryStore { State = new(Guid.NewGuid(), Tokens(), null, []) };
+        Guid? requestId = null;
+        var refreshed = Tokens() with { AccessToken = new string('C', 64), AccessTokenExpiresAtUtc = DateTimeOffset.UtcNow.AddMinutes(15) };
+        var calls = 0;
+        var handler = new Handler(async request =>
+        {
+            if (request.RequestUri!.AbsolutePath.EndsWith("refresh"))
+            {
+                var body = await request.Content!.ReadFromJsonAsync<JsonElement>();
+                var id = body.GetProperty("requestId").GetGuid();
+                if (requestId is null) requestId = id;
+                Assert.Equal(requestId, id);
+                if (++calls == 1) throw new HttpRequestException("Simulated lost response");
+                return Json(refreshed);
+            }
+            Assert.Equal("Bearer", request.Headers.Authorization!.Scheme);
+            Assert.Equal(refreshed.AccessToken, request.Headers.Authorization.Parameter);
+            return Json(refreshed.User);
+        });
+        var first = new CloudAccountClient(Http(handler), store);
+        Assert.True((await first.RestoreAsync())!.IsOffline);
+        Assert.NotNull(store.State.RefreshRequestId);
+        var restarted = new CloudAccountClient(Http(handler), store);
+        var states = await Task.WhenAll(Enumerable.Range(0, 3).Select(_ => restarted.RestoreAsync()));
+        Assert.All(states, state => Assert.False(state!.IsOffline));
+        Assert.Equal(2, calls);
+        Assert.Null(store.State.RefreshRequestId);
+    }
+
+    [Fact]
+    public async Task OfflineLogout_ClearsActiveCredentialDurably_AndRetriesOnlyOldSession()
+    {
+        var tokens = Tokens();
+        var store = new MemoryStore { State = new(Guid.NewGuid(), tokens, null, []) };
+        var offline = true;
+        var handler = new Handler(async request =>
+        {
+            Assert.EndsWith("logout", request.RequestUri!.AbsolutePath);
+            Assert.Null(store.State.Tokens);
+            var body = await request.Content!.ReadFromJsonAsync<JsonElement>();
+            Assert.Equal(tokens.RefreshToken, body.GetProperty("refreshToken").GetString());
+            if (offline) throw new HttpRequestException("offline");
+            return new(HttpStatusCode.NoContent);
+        });
+        await new CloudAccountClient(Http(handler), store).LogoutAsync();
+        Assert.Null(store.State.Tokens);
+        Assert.Single(store.State.PendingLogouts);
+        offline = false;
+        Assert.Null(await new CloudAccountClient(Http(handler), store).RestoreAsync());
+        Assert.Empty(store.State.PendingLogouts);
+    }
+
+    [Fact]
+    public async Task RevokedCredential_ClearsLogin_AndDoesNotGrantMembership()
+    {
+        var store = new MemoryStore { State = new(Guid.NewGuid(), Tokens(), null, []) };
+        var client = new CloudAccountClient(Http(new Handler(_ => Task.FromResult(new HttpResponseMessage(HttpStatusCode.Unauthorized)
+            { Content = JsonContent.Create(new { code = "invalid_session" }) }))), store);
+        Assert.Null(await client.RestoreAsync());
+        Assert.Null(store.State.Tokens);
+    }
+
+    [Fact]
+    public void Dpapi_RoundTripsAcrossInstances_ContainsNoPlaintext_AndBindsApiOrigin()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "focustime-auth-test-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var uri = new Uri("https://api.example.test/");
+            var state = new CredentialState(Guid.NewGuid(), Tokens(), Guid.NewGuid(), ["pending-secret"]);
+            new WindowsCredentialStore(uri, directory).Save(state);
+            var restored = new WindowsCredentialStore(uri, directory).Load();
+            Assert.Equal(state.Tokens, restored.Tokens);
+            Assert.Equal(state.InstallationId, restored.InstallationId);
+            var bytes = File.ReadAllBytes(Directory.GetFiles(directory).Single());
+            Assert.DoesNotContain(state.Tokens!.RefreshToken, Encoding.UTF8.GetString(bytes));
+            Assert.DoesNotContain("pending-secret", Encoding.UTF8.GetString(bytes));
+            var other = new WindowsCredentialStore(new Uri("https://another.example.test/"), directory);
+            Assert.Null(other.Load().Tokens);
+            File.WriteAllText(Directory.GetFiles(directory).Single(), "corrupt");
+            Assert.Null(new WindowsCredentialStore(uri, directory).Load().Tokens);
+        }
+        finally
+        {
+            foreach (var file in Directory.GetFiles(directory)) File.Delete(file);
+            Directory.Delete(directory);
+        }
+    }
+
+    [Fact]
+    public async Task ProductionClient_DoesNotAcceptLegacyFixtureCredentials_AndReportsNetworkFailure()
+    {
+        var store = new MemoryStore();
+        var client = new CloudAccountClient(Http(new Handler(_ => throw new HttpRequestException("offline"))), store);
+        var model = new AuthModalViewModel(client) { LoginAccount = "123", LoginPassword = "123" };
+        model.OpenLogin();
+        await ((AsyncCommand)model.LoginCommand).ExecuteAsync();
+        Assert.True(model.IsOpen);
+        Assert.True(model.HasLoginError);
+        Assert.Contains("无法连接", model.StatusMessage);
+        Assert.Null(store.State.Tokens);
+    }
+
+    internal sealed class MemoryStore : ICredentialStore
+    {
+        public CredentialState State { get; set; } = new(Guid.NewGuid(), null, null, []);
+        public CredentialState Load() => State;
+        public void Save(CredentialState state) => State = state;
+    }
+    private sealed class Handler(Func<HttpRequestMessage, Task<HttpResponseMessage>> send) : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken) => send(request);
+    }
+    private static HttpClient Http(HttpMessageHandler handler) => new(handler) { BaseAddress = new("http://localhost:5080/") };
+    private static HttpResponseMessage Json<T>(T value) => new(HttpStatusCode.OK) { Content = JsonContent.Create(value) };
+}
