+using FocusApp.Desktop.Services.Cloud;
+using FocusApp.Desktop.ViewModels;
+
+namespace FocusApp.Tests.Desktop;
+
+// Only UI regression tests use these legacy presentation fixtures.
+internal sealed class FakeAccountClient : IAccountClient
+{
+    public Task<CloudAccount> LoginAsync(string email, string password)
+    {
+        var membership = (email, password) switch
+        {
+            ("123", "123") => MembershipType.Normal,
+            ("456", "456") => MembershipType.Annual,
+            ("789", "789") => MembershipType.Lifetime,
+            _ => throw new CloudApiException("invalid_credentials")
+        };
+        return Task.FromResult(new CloudAccount(Guid.NewGuid(), email + "@focusapp.local", false, membership));
+    }
+    public Task<EmailChallenge> SendCodeAsync(string email, bool reset) =>
+        Task.FromResult(new EmailChallenge(Guid.NewGuid(), DateTimeOffset.UtcNow.AddMinutes(10), 60));
+    public Task RegisterAsync(string email, Guid challengeId, string code, string password) => Task.CompletedTask;
+    public Task<ResetTicket> VerifyResetAsync(Guid challengeId, string code) =>
+        Task.FromResult(new ResetTicket("test-only", DateTimeOffset.UtcNow.AddMinutes(10)));
+    public Task CompleteResetAsync(string ticket, string password) => Task.CompletedTask;
+    public Task<CloudAccount?> RestoreAsync() => Task.FromResult<CloudAccount?>(null);
+    public Task LogoutAsync() => Task.CompletedTask;
+}
