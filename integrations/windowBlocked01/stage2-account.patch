@@ -0,0 +1,98 @@
+using System.IO;
+using System.Net.Http;
+using System.Text;
+using System.Text.RegularExpressions;
+using FocusApp.Desktop.Services.Cloud;
+using FocusApp.Desktop.ViewModels;
+using Xunit;
+
+namespace FocusApp.Tests.Desktop;
+
+public sealed class LiveAccountFactAttribute : FactAttribute
+{
+    public LiveAccountFactAttribute()
+    {
+        if (Environment.GetEnvironmentVariable("FOCUSTIME_TEST_API") is null)
+            Skip = "Run the isolated backend account-client validation script.";
+    }
+}
+
+public sealed class CloudAccountLiveTests
+{
+    [LiveAccountFact]
+    public async Task ExistingAuthViewModel_RegistersLogsInRestoresAndResetsAgainstRealApi()
+    {
+        var uri = new Uri(Environment.GetEnvironmentVariable("FOCUSTIME_TEST_API")!);
+        var mailFolder = Environment.GetEnvironmentVariable("FOCUSTIME_TEST_MAIL")!;
+        var folder = Path.Combine(Path.GetTempPath(), "focustime-live-" + Guid.NewGuid().ToString("N"));
+        var email = "client-" + Guid.NewGuid().ToString("N") + "@example.test";
+        try
+        {
+            var store = new WindowsCredentialStore(uri, folder);
+            using var http = new HttpClient { BaseAddress = uri };
+            var model = new AuthModalViewModel(new CloudAccountClient(http, store));
+            model.OpenLogin();
+            model.ShowRegisterCommand.Execute(null);
+            model.RegisterEmail = email;
+            await ((AsyncCommand)model.SendRegisterCodeCommand).ExecuteAsync();
+            Assert.Contains("验证码已发送", model.StatusMessage);
+            model.RegisterCode = Code(mailFolder, email);
+            model.RegisterPassword = model.RegisterConfirmPassword = "ClientTest12345";
+            model.AgreementAccepted = true;
+            await ((AsyncCommand)model.RegisterCommand).ExecuteAsync();
+            Assert.Contains("注册成功", model.StatusMessage);
+            model.LoginPassword = "ClientTest12345";
+            LoginSucceededEventArgs? signedIn = null;
+            model.LoginSucceeded += (_, args) => signedIn = args;
+            await ((AsyncCommand)model.LoginCommand).ExecuteAsync();
+            Assert.NotNull(signedIn);
+            Assert.Equal(email, signedIn!.Account);
+            Assert.Equal(MembershipType.Normal, signedIn.MembershipType);
+            Assert.Empty(model.LoginPassword);
+            var restored = new CloudAccountClient(http, new WindowsCredentialStore(uri, folder));
+            Assert.Equal(email, (await restored.RestoreAsync())!.Email);
+            await restored.LogoutAsync();
+            Assert.Null(await restored.RestoreAsync());
+
+            await Task.Delay(TimeSpan.FromSeconds(61));
+            model.OpenLogin();
+            model.StartPasswordRecoveryCommand.Execute(null);
+            model.RecoveryAccount = email;
+            await ((AsyncCommand)model.ContinueRecoveryCommand).ExecuteAsync();
+            Assert.True(model.IsRecoveryVerificationStep);
+            model.RecoveryCode = Code(mailFolder, email);
+            await ((AsyncCommand)model.VerifyRecoveryCodeCommand).ExecuteAsync();
+            Assert.True(model.IsRecoveryNewPasswordStep);
+            model.RecoveryNewPassword = model.RecoveryConfirmPassword = "ResetClient12345";
+            await ((AsyncCommand)model.CompletePasswordRecoveryCommand).ExecuteAsync();
+            Assert.True(model.IsRecoveryCompletedStep);
+            model.ReturnToLoginCommand.Execute(null);
+            model.LoginAccount = email;
+            model.LoginPassword = "ResetClient12345";
+            signedIn = null;
+            await ((AsyncCommand)model.LoginCommand).ExecuteAsync();
+            Assert.NotNull(signedIn);
+            await model.LogoutAsync();
+        }
+        finally
+        {
+            if (Directory.Exists(folder))
+            { foreach (var file in Directory.GetFiles(folder)) File.Delete(file); Directory.Delete(folder); }
+        }
+    }
+    private static string Code(string directory, string email)
+    {
+        foreach (var file in Directory.GetFiles(directory, "*.eml").OrderByDescending(File.GetLastWriteTimeUtc))
+        {
+            var text = File.ReadAllText(file);
+            if (!text.Contains(email, StringComparison.OrdinalIgnoreCase)) continue;
+            var boundary = text.IndexOf("\r\n\r\n", StringComparison.Ordinal);
+            var body = text[(boundary + 4)..].Trim();
+            if (text[..boundary].Contains("base64", StringComparison.OrdinalIgnoreCase))
+                body = Encoding.UTF8.GetString(Convert.FromBase64String(body));
+            var match = Regex.Match(body, "[0-9]{6}");
+            if (match.Success) return match.Value;
+        }
+        throw new InvalidOperationException("Development pickup mail was not found.");
+    }
+}
