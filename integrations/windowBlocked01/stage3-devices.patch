@@ -0,0 +1,16 @@
+using FocusApp.Desktop.Services.Cloud;
+
+namespace FocusApp.Tests.Desktop;
+
+internal sealed class FakeDeviceSessionClient : IDeviceSessionClient
+{
+    public event EventHandler? SessionEnded;
+    public int Revocations { get; private set; }
+    public List<CloudDevice> Devices { get; } = [new(Guid.NewGuid(), "Test PC", "Windows", "3.0",
+        DateTimeOffset.UtcNow, DateTimeOffset.UtcNow, false, [new(Guid.NewGuid(), DateTimeOffset.UtcNow,
+            DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(30), false)])];
+    public Task<IReadOnlyList<CloudDevice>> GetDevicesAsync() => Task.FromResult<IReadOnlyList<CloudDevice>>(Devices.ToArray());
+    public Task RevokeDeviceAsync(Guid deviceId) { Revocations++; Devices.RemoveAll(x => x.Id == deviceId); return Task.CompletedTask; }
+    public Task RevokeSessionAsync(Guid sessionId) { Revocations++; Devices.Clear(); return Task.CompletedTask; }
+    public Task LogoutAllAsync() { Revocations++; Devices.Clear(); SessionEnded?.Invoke(this, EventArgs.Empty); return Task.CompletedTask; }
+}
