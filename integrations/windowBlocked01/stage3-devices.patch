+++ b/tests/FocusApp.Tests/Desktop/CloudDeviceLiveTests.cs
@@ -0,0 +1,58 @@
+using System.IO;
+using System.Net.Http;
+using System.Text;
+using System.Text.RegularExpressions;
+using FocusApp.Desktop.Services.Cloud;
+using FocusApp.Desktop.ViewModels;
+using Xunit;
+
+namespace FocusApp.Tests.Desktop;
+
+public sealed class CloudDeviceLiveTests
+{
+    [LiveAccountFact]
+    public async Task TwoInstallations_ListRemoteLogout_ReLoginAndLogoutAll_ThroughRealApiAndDeviceViewModel()
+    {
+        var uri = new Uri(Environment.GetEnvironmentVariable("FOCUSTIME_TEST_API")!);
+        var mail = Environment.GetEnvironmentVariable("FOCUSTIME_TEST_MAIL")!;
+        var folder = Path.Combine(Path.GetTempPath(),"focustime-devices-"+Guid.NewGuid().ToString("N"));
+        var email = "devices-"+Guid.NewGuid().ToString("N")+"@example.test";
+        Directory.CreateDirectory(folder);
+        try
+        {
+            using var httpA = new HttpClient { BaseAddress = uri }; using var httpB = new HttpClient { BaseAddress = uri };
+            var storeA = new WindowsCredentialStore(uri,Path.Combine(folder,"a"));
+            var storeB = new WindowsCredentialStore(uri,Path.Combine(folder,"b"));
+            var a = new CloudAccountClient(httpA,storeA); var b = new CloudAccountClient(httpB,storeB);
+            var challenge = await a.SendCodeAsync(email,false);
+            var message = Directory.GetFiles(mail,"*.eml").Select(File.ReadAllText).Single(x=>x.Contains(email,StringComparison.OrdinalIgnoreCase));
+            var headerEnd = message.IndexOf("\r\n\r\n",StringComparison.Ordinal); var body = message[(headerEnd+4)..].Trim();
+            if(message[..headerEnd].Contains("base64",StringComparison.OrdinalIgnoreCase)) body=Encoding.UTF8.GetString(Convert.FromBase64String(body));
+            await a.RegisterAsync(email,challenge.ChallengeId,Regex.Match(body,"[0-9]{6}").Value,"DeviceClient123");
+            await a.LoginAsync(email,"DeviceClient123"); await b.LoginAsync(email,"DeviceClient123");
+            Assert.NotEqual(storeA.Load().InstallationId,storeB.Load().InstallationId);
+            var authB = new AuthModalViewModel(b); var expiredB = false; authB.SessionCleared += (_,_)=>expiredB=true;
+            var panel = new AccountSyncModalViewModel(a); panel.Open(); await CloudDeviceClientTests.Wait(()=>!panel.IsBusy);
+            Assert.Equal(2,panel.Devices.Count); Assert.Single(panel.Devices,x=>x.IsCurrentDevice);
+            var remote = panel.Devices.Single(x=>!x.IsCurrentDevice);
+            panel.OpenDeviceLogoutConfirmationCommand.Execute(remote);
+            Assert.Contains(remote.Name,panel.PendingLogoutName);
+            await ((AsyncCommand)panel.ConfirmDeviceLogoutCommand).ExecuteAsync();
+            Assert.Single(panel.Devices); Assert.Null(await b.RestoreAsync()); Assert.True(expiredB);
+            Assert.Null(storeB.Load().Tokens); Assert.NotNull(await a.RestoreAsync());
+            await b.LoginAsync(email,"DeviceClient123");
+            Assert.Equal(remote.Id,(await a.GetDevicesAsync()).Single(x=>!x.IsCurrentDevice).Id);
+            await ((AsyncCommand)panel.RefreshDevicesCommand).ExecuteAsync();
+            panel.OpenLogoutAllConfirmationCommand.Execute(null);
+            await ((AsyncCommand)panel.ConfirmDeviceLogoutCommand).ExecuteAsync();
+            Assert.Null(storeA.Load().Tokens); Assert.False(panel.IsOpen); Assert.Null(await b.RestoreAsync());
+        }
+        finally
+        {
+            // Only remove files in the randomly generated test directories, without recursion.
+            foreach(var dir in new[]{Path.Combine(folder,"a"),Path.Combine(folder,"b")})
+                if(Directory.Exists(dir)){foreach(var file in Directory.GetFiles(dir))File.Delete(file);Directory.Delete(dir);}
+            Directory.Delete(folder);
+        }
+    }
+}
