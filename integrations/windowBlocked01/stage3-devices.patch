diff --git a/src/FocusApp.Desktop/Services/Cloud/IDeviceSessionClient.cs b/src/FocusApp.Desktop/Services/Cloud/IDeviceSessionClient.cs
new file mode 100644
--- /dev/null
+++ b/src/FocusApp.Desktop/Services/Cloud/IDeviceSessionClient.cs
@@ -0,0 +1,23 @@
+namespace FocusApp.Desktop.Services.Cloud;
+
+public sealed record CloudSession(Guid Id, DateTimeOffset CreatedAtUtc, DateTimeOffset LastSeenAtUtc,
+    DateTimeOffset ExpiresAtUtc, bool IsCurrentSession)
+{
+    public string Label => IsCurrentSession ? "当前会话" : "其他登录会话";
+    public string Activity => $"最近活动：{LastSeenAtUtc.ToLocalTime():yyyy-MM-dd HH:mm}";
+}
+public sealed record CloudDevice(Guid Id, string Name, string OperatingSystem, string ClientVersion,
+    DateTimeOffset FirstSeenAtUtc, DateTimeOffset LastSeenAtUtc, bool IsCurrentDevice,
+    IReadOnlyList<CloudSession> Sessions)
+{
+    public string Metadata => $"{OperatingSystem} · {ClientVersion} · 最近活动 {LastSeenAtUtc.ToLocalTime():yyyy-MM-dd HH:mm}";
+    public string SessionCount => $"登录会话（{Sessions.Count}）";
+}
+public interface IDeviceSessionClient
+{
+    event EventHandler? SessionEnded;
+    Task<IReadOnlyList<CloudDevice>> GetDevicesAsync();
+    Task RevokeDeviceAsync(Guid deviceId);
+    Task RevokeSessionAsync(Guid sessionId);
+    Task LogoutAllAsync();
+}
diff --git a/tests/FocusApp.Tests/Desktop/CloudDeviceClientTests.cs b/tests/FocusApp.Tests/Desktop/CloudDeviceClientTests.cs
new file mode 100644
--- /dev/null
+++ b/tests/FocusApp.Tests/Desktop/CloudDeviceClientTests.cs
@@ -0,0 +1,135 @@
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Json;
+using System.Text.Json;
+using FocusApp.Desktop.Services.Cloud;
+using FocusApp.Desktop.ViewModels;
+using Xunit;
+
+namespace FocusApp.Tests.Desktop;
+
+public sealed class CloudDeviceClientTests
+{
+    private static CloudTokens Tokens() => new("Bearer", new string('A',64), DateTimeOffset.UtcNow.AddMinutes(15),
+        new string('B',64), DateTimeOffset.UtcNow.AddDays(30), Guid.NewGuid(), Guid.NewGuid(), new(Guid.NewGuid(), "user@example.test", true));
+    private static CloudAccountClient Client(CloudAccountClientTests.MemoryStore store,
+        Func<HttpRequestMessage, Task<HttpResponseMessage>> send) => new(new HttpClient(new Handler(send))
+        { BaseAddress = new("http://localhost:5080/") }, store);
+    private sealed class Handler(Func<HttpRequestMessage, Task<HttpResponseMessage>> send) : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct) => send(request);
+    }
+
+    [Fact]
+    public async Task RevokeOtherDevice_PreservesCurrentCredentials_ThenRevokeCurrentSessionClearsThem()
+    {
+        var tokens = Tokens(); var store = new CloudAccountClientTests.MemoryStore { State = new(Guid.NewGuid(),tokens,null,[]) };
+        var other = Guid.NewGuid(); var paths = new List<string>();
+        var client = Client(store, request =>
+        {
+            Assert.Equal(tokens.AccessToken, request.Headers.Authorization!.Parameter);
+            paths.Add(request.RequestUri!.AbsolutePath);
+            Assert.Equal(HttpMethod.Delete, request.Method);
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.NoContent));
+        });
+        var ended = 0; client.SessionEnded += (_,_) => ended++;
+        await client.RevokeDeviceAsync(other);
+        Assert.NotNull(store.State.Tokens); Assert.Equal(0, ended);
+        await client.RevokeSessionAsync(tokens.SessionId);
+        Assert.Null(store.State.Tokens); Assert.Equal(1, ended);
+        Assert.Equal(new[] { $"/api/v1/me/devices/{other}/sessions", $"/api/v1/me/sessions/{tokens.SessionId}" }, paths);
+    }
+
+    [Fact]
+    public async Task ServerRevocation_ClearsStoredSession_AndNotifiesAuthViewModel()
+    {
+        var store = new CloudAccountClientTests.MemoryStore { State = new(Guid.NewGuid(),Tokens(),null,[]) };
+        var client = Client(store, _ => Task.FromResult(new HttpResponseMessage(HttpStatusCode.Unauthorized)
+            { Content = JsonContent.Create(new { code = "invalid_session" }) }));
+        var auth = new AuthModalViewModel(client); var ended = false;
+        auth.SessionCleared += (_,_) => ended = true;
+        await Assert.ThrowsAsync<CloudApiException>(() => client.GetDevicesAsync());
+        Assert.True(ended); Assert.Null(store.State.Tokens);
+        Assert.Contains("重新登录", auth.StatusMessage);
+    }
+
+    [Fact]
+    public async Task NetworkFailure_DoesNotClearCredentialsOrPretendDeviceWasRemoved()
+    {
+        var tokens = Tokens(); var store = new CloudAccountClientTests.MemoryStore { State = new(Guid.NewGuid(),tokens,null,[]) };
+        var device = new CloudDevice(Guid.NewGuid(),"Other PC","Windows","3",DateTimeOffset.UtcNow,DateTimeOffset.UtcNow,false,[]);
+        var client = Client(store, request => request.Method == HttpMethod.Get ? Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)
+            { Content = JsonContent.Create(new[] { device }) }) : throw new HttpRequestException("Offline"));
+        var panel = new AccountSyncModalViewModel(client);
+        panel.Open();
+        await Wait(() => !panel.IsBusy);
+        panel.OpenDeviceLogoutConfirmationCommand.Execute(panel.Devices[0]);
+        await ((AsyncCommand)panel.ConfirmDeviceLogoutCommand).ExecuteAsync();
+        Assert.Single(panel.Devices); Assert.True(panel.IsDeviceLogoutConfirmationActive);
+        Assert.Contains("尚未确认", panel.DeviceStatus); Assert.NotNull(store.State.Tokens);
+    }
+
+    [Fact]
+    public async Task UnauthorizedAccessWithClockSkew_RefreshesBeforeRetryingDeviceRequest()
+    {
+        var old = Tokens(); var rotated = old with { AccessToken = new string('C',64) };
+        var store = new CloudAccountClientTests.MemoryStore { State = new(Guid.NewGuid(),old,null,[]) };
+        var refreshes = 0; var reads = 0;
+        var client = Client(store, async request =>
+        {
+            if (request.RequestUri!.AbsolutePath.EndsWith("refresh"))
+            {
+                refreshes++; var body = await request.Content!.ReadFromJsonAsync<JsonElement>();
+                Assert.Equal(old.RefreshToken, body.GetProperty("refreshToken").GetString());
+                Assert.NotEqual(Guid.Empty, body.GetProperty("requestId").GetGuid());
+                return new(HttpStatusCode.OK) { Content = JsonContent.Create(rotated) };
+            }
+            reads++;
+            return reads == 1 ? new(HttpStatusCode.Unauthorized) : new(HttpStatusCode.OK) { Content = JsonContent.Create(Array.Empty<CloudDevice>()) };
+        });
+        Assert.Empty(await client.GetDevicesAsync());
+        Assert.Equal(1,refreshes); Assert.Equal(2,reads); Assert.Equal(rotated,store.State.Tokens);
+    }
+
+    [Fact]
+    public async Task LogoutAll_UsesProtectedEndpoint_AndClearsCurrentSession()
+    {
+        var store = new CloudAccountClientTests.MemoryStore { State = new(Guid.NewGuid(),Tokens(),null,[]) };
+        var client = Client(store, request =>
+        {
+            Assert.Equal(HttpMethod.Post,request.Method); Assert.EndsWith("/auth/logout-all",request.RequestUri!.AbsolutePath);
+            Assert.NotNull(request.Headers.Authorization);
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.NoContent));
+        });
+        await client.LogoutAllAsync(); Assert.Null(store.State.Tokens);
+    }
+
+    internal static async Task Wait(Func<bool> predicate)
+    {
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(8));
+        while (!predicate()) await Task.Delay(10,timeout.Token);
+    }
+
+    [Fact]
+    public async Task AccountClearedWhileListIsInFlight_DropsTheOldAccountResponse()
+    {
+        var client = new DelayedDevices();
+        var panel = new AccountSyncModalViewModel(client);
+        panel.Open(); Assert.True(panel.IsBusy);
+        panel.ClearDevices();
+        client.Reply.SetResult([new(Guid.NewGuid(),"Previous account PC","Windows","3",DateTimeOffset.UtcNow,
+            DateTimeOffset.UtcNow,false,[])]);
+        await Wait(() => !panel.IsBusy);
+        Assert.Empty(panel.Devices);
+    }
+
+    private sealed class DelayedDevices : IDeviceSessionClient
+    {
+        public event EventHandler? SessionEnded { add { } remove { } }
+        public TaskCompletionSource<IReadOnlyList<CloudDevice>> Reply { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public Task<IReadOnlyList<CloudDevice>> GetDevicesAsync() => Reply.Task;
+        public Task RevokeDeviceAsync(Guid id) => Task.CompletedTask;
+        public Task RevokeSessionAsync(Guid id) => Task.CompletedTask;
+        public Task LogoutAllAsync() => Task.CompletedTask;
+    }
+}
