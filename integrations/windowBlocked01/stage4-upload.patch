@@ -0,0 +1,87 @@
+using System.IO;
+using System.IO.Pipes;
+using FocusApp.Contracts;
+using FocusApp.Core;
+using FocusApp.Desktop.Services;
+using FocusApp.Infrastructure.Persistence;
+using FocusApp.Service;
+using Microsoft.Data.Sqlite;
+
+namespace FocusApp.Tests.Sync;
+
+internal sealed class FocusSyncHarness : IAsyncDisposable
+{
+    public string DirectoryPath {get;}=Path.Combine(Path.GetTempPath(),"FocusApp.Stage4",Guid.NewGuid().ToString("N"));
+    public string DatabasePath=>Path.Combine(DirectoryPath,"focus.db");
+    public SqliteLocalDataStore Store {get;}
+    public ServiceStateCoordinator Coordinator {get;}
+    public DesktopServiceConnection Connection {get;}
+    private readonly CancellationTokenSource stop=new();
+    private readonly Task server;
+    private long clock=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+    public DateTimeOffset Now=>DateTimeOffset.FromUnixTimeMilliseconds(Interlocked.Read(ref clock));
+    public void Advance(TimeSpan duration)=>Interlocked.Add(ref clock,(long)duration.TotalMilliseconds);
+    public FocusSyncHarness()
+    {
+        Directory.CreateDirectory(DirectoryPath);Store=new(DatabasePath);
+        Coordinator=new(Store,new NoAccessHost(),utcNowProvider:()=>Now,clockPollInterval:TimeSpan.FromMilliseconds(25));
+        var name="focus-upload-"+Guid.NewGuid().ToString("N");
+        Connection=new(name,connectTimeout:TimeSpan.FromSeconds(2),requestTimeout:TimeSpan.FromSeconds(5),initialRetryDelay:TimeSpan.FromMilliseconds(20));
+        server=Task.Run(async()=>
+        {
+            while(!stop.IsCancellationRequested)
+            {
+                using var pipe=new NamedPipeServerStream(name,PipeDirection.InOut,1,PipeTransmissionMode.Byte,PipeOptions.Asynchronous);
+                try
+                {
+                    await pipe.WaitForConnectionAsync(stop.Token);
+                    while(!stop.IsCancellationRequested)
+                    {
+                        var request=await IpcFrameCodec.ReadAsync(pipe,stop.Token);if(request is null)break;
+                        var response=await Coordinator.HandleAsync(request,stop.Token);
+                        await IpcFrameCodec.WriteAsync(pipe,response,stop.Token);
+                    }
+                }
+                catch(Exception e)when(e is IOException or OperationCanceledException){ }
+            }
+        });
+    }
+    public async Task ConnectAsync(){await Connection.StartAsync();await WaitAsync(()=>Connection.IsConnected);}
+    public static async Task WaitAsync(Func<bool> condition)
+    {using var timeout=new CancellationTokenSource(TimeSpan.FromSeconds(12));while(!condition())await Task.Delay(20,timeout.Token);}
+    public async Task<T> RequestAsync<T>(string operation,object payload,IpcClientRole role=IpcClientRole.Desktop)
+    {
+        var response=await Coordinator.HandleAsync(IpcEnvelope.CreateRequest(Guid.NewGuid(),role,operation,payload),CancellationToken.None);
+        if(response.Error is not null)throw new IpcRemoteException(response.Error);return response.ReadPayload<T>();
+    }
+    public static LocalFocusSession Record(Guid? binding=null,Guid? id=null,bool forced=false)
+    {
+        var end=DateTimeOffset.UtcNow;
+        return new(id??Guid.NewGuid(),LocalFocusSessionStatus.Completed,forced,1500,1500,end.AddSeconds(-1505),end.AddSeconds(-1500),end,end,
+            FocusCompletionKind.Natural,"goal","目标",true,null,null,
+            [new("task","任务",0){CompletedAtUtc=end,Details=new("说明",[new("步骤",true)])}])
+        {CloudBindingId=binding,WebsiteRuleSnapshots=[new(Guid.NewGuid(),"private","private-block.example",true,0)],
+         ApplicationRuleSnapshots=[new(Guid.NewGuid(),"private","C:/private.exe",true,0)]};
+    }
+    public async ValueTask DisposeAsync()
+    {
+        await Connection.DisposeAsync();stop.Cancel();try{await server;}catch(OperationCanceledException){}
+        await Coordinator.DisposeAsync();SqliteConnection.ClearAllPools();
+        var full=Path.GetFullPath(DirectoryPath);var root=Path.GetFullPath(Path.Combine(Path.GetTempPath(),"FocusApp.Stage4"))+Path.DirectorySeparatorChar;
+        if(full.StartsWith(root,StringComparison.OrdinalIgnoreCase)&&Directory.Exists(full))Directory.Delete(full,true);
+        stop.Dispose();
+    }
+    private sealed class NoAccessHost : IAccessControlExecutionHost
+    {
+        public bool WebsiteActive=>false;
+        public bool ApplicationActive=>false;
+        public int? ProxyPort=>null;
+        public event EventHandler<AccessBlockedEvent>? AccessBlocked {add{}remove{}}
+        public event EventHandler<string>? ExecutionFailed {add{}remove{}}
+        public Task<AccessControlHostStartResult> StartAsync(IReadOnlyCollection<WebsiteAccessRule> websites,IReadOnlyCollection<ApplicationAccessRule> applications,CancellationToken ct=default)=>Task.FromResult(new AccessControlHostStartResult(false,false,null));
+        public void UpdateRules(IReadOnlyCollection<WebsiteAccessRule> websites,IReadOnlyCollection<ApplicationAccessRule> applications){}
+        public void ConfigureUpstream(UpstreamProxyConfigurationDto? upstream){}
+        public Task StopAsync(CancellationToken ct=default)=>Task.CompletedTask;
+        public ValueTask DisposeAsync()=>ValueTask.CompletedTask;
+    }
+}
