+
+namespace FocusApp.Tests.Sync;
+
+public sealed class FocusUploadWorkerTests
+{
+    private sealed class Cloud : IFocusUploadClient
+    {
+        public event EventHandler? IdentityChanged;
+        public FocusUploadIdentity? Identity {get;private set;}=new(Guid.NewGuid(),"a@example.test",new string('A',64));
+        public int Calls {get;private set;}
+        public Dictionary<Guid,Guid> Received {get;}=[];
+        public bool LoseFirstResponse {get;set;}
+        public TaskCompletionSource? Entered {get;set;}
+        public TaskCompletionSource? Release {get;set;}
+        public Task<FocusUploadIdentity?> GetUploadIdentityAsync()=>Task.FromResult(Identity);
+        public void Change(){Identity=new(Guid.NewGuid(),"b@example.test",new string('A',64));IdentityChanged?.Invoke(this,EventArgs.Empty);}
+        public async Task<IReadOnlyList<CloudSyncAck>> PushFocusRecordsAsync(FocusUploadIdentity identity,IReadOnlyList<CloudSyncItem> items)
+        {
+            Calls++;Entered?.TrySetResult();if(Release is not null)await Release.Task;
+            var results=items.Select(x=>new CloudSyncAck(x.OperationId,x.RecordId,Received.TryAdd(x.OperationId,x.RecordId)?"applied":"duplicate",1,null)).ToArray();
+            if(LoseFirstResponse&&Calls==1)throw new HttpRequestException("Lost response");return results;
+        }
+    }
+    [Fact]
+    public async Task HistoricalImportRequiresConfirmation_AndAccountChangeCancelsOldProposal()
+    {
+        await using var h=new FocusSyncHarness();await h.Store.SaveFocusSessionAsync(FocusSyncHarness.Record(Guid.Empty));await h.ConnectAsync();
+        var cloud=new Cloud();var worker=new FocusUploadCoordinator(h.Connection,cloud,false);await worker.TickAsync();
+        Assert.Equal(0,cloud.Calls);worker.PrepareImportCommand.Execute(null);Assert.True(worker.HasImportConfirmation);Assert.Contains("a@example.test",worker.ImportQuestion);
+        cloud.Change();await FocusSyncHarness.WaitAsync(()=>!worker.IsBusy);Assert.False(worker.HasImportConfirmation);
+        await worker.ConfirmImportAsync();Assert.Equal(0,cloud.Calls);
+        worker.PrepareImportCommand.Execute(null);Assert.Contains("b@example.test",worker.ImportQuestion);await worker.ConfirmImportAsync();
+        Assert.Single(cloud.Received);Assert.Contains("已确认 1",worker.Summary);
+    }
+    [Fact]
+    public async Task ResponseLostAfterCommit_RetryUsesSameOperation_AndClearsOnlyAfterReceipt()
+    {
+        await using var h=new FocusSyncHarness();await h.ConnectAsync();var cloud=new Cloud{LoseFirstResponse=true};
+        var worker=new FocusUploadCoordinator(h.Connection,cloud,false);await worker.TickAsync();
+        await h.Store.SaveFocusSessionAsync(FocusSyncHarness.Record(h.Connection.CloudBindingId));await worker.TickAsync();
+        Assert.Single(cloud.Received);Assert.Contains("待上传 1",worker.Summary);
+        var restarted=new FocusUploadCoordinator(h.Connection,cloud,false);await restarted.SyncNowCommand.ExecuteAsync();
+        Assert.Single(cloud.Received);Assert.Contains("已确认 1",restarted.Summary);
+    }
+    [Fact]
+    public async Task BlockedCloudNetworkDoesNotHoldLocalSaveTransaction()
+    {
+        await using var h=new FocusSyncHarness();await h.ConnectAsync();var cloud=new Cloud();var worker=new FocusUploadCoordinator(h.Connection,cloud,false);await worker.TickAsync();
+        await h.Store.SaveFocusSessionAsync(FocusSyncHarness.Record(h.Connection.CloudBindingId));
+        cloud.Entered=new(TaskCreationOptions.RunContinuationsAsynchronously);cloud.Release=new(TaskCreationOptions.RunContinuationsAsynchronously);
+        var uploading=worker.TickAsync();await cloud.Entered.Task.WaitAsync(TimeSpan.FromSeconds(3));
+        await h.Store.SaveFocusSessionAsync(FocusSyncHarness.Record(h.Connection.CloudBindingId)).WaitAsync(TimeSpan.FromSeconds(3));
+        cloud.Release.SetResult();await uploading;Assert.Equal(2,(await h.Store.LoadAsync()).FocusSessions.Count);
+        Assert.Contains("待上传 1",worker.Summary);
+    }
+    private sealed class Handler(Func<HttpRequestMessage,Task<HttpResponseMessage>> send):HttpMessageHandler
+    {protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request,CancellationToken ct)=>send(request);}
+    [Fact]
+    public async Task CloudTransportRejectsWrongAccountBeforeSending_AndRejectsIncompleteAcknowledgements()
+    {
+        var uid=Guid.NewGuid();var tokens=new CloudTokens("Bearer",new string('A',64),DateTimeOffset.UtcNow.AddMinutes(15),new string('B',64),DateTimeOffset.UtcNow.AddDays(30),Guid.NewGuid(),Guid.NewGuid(),new(uid,"a@example.test",true));
+        var vault=new CloudAccountClientTests.MemoryStore{State=new(Guid.NewGuid(),tokens,null,[])};var calls=0;
+        using var http=new HttpClient(new Handler(async request=>
+        {
+            calls++;Assert.Equal(tokens.AccessToken,request.Headers.Authorization!.Parameter);
