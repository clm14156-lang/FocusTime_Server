+    public async Task DesktopCanBindReadAndAcknowledge_WhileAgentCannotReadUploadData()
+    {
+        await using var h=new FocusSyncHarness();var b=await h.RequestAsync<CloudSyncBinding>(FocusSyncIpc.Bind,new CloudSyncBindCommand(Guid.NewGuid(),new string('A',64)));
+        await h.Store.SaveFocusSessionAsync(FocusSyncHarness.Record(b.BindingId));
+        var batch=await h.RequestAsync<CloudSyncBatch>(FocusSyncIpc.Batch,new CloudSyncBatchCommand(b.BindingId,50));Assert.Single(batch.Items);
+        var denied=await h.Coordinator.HandleAsync(IpcEnvelope.CreateRequest(Guid.NewGuid(),IpcClientRole.Agent,FocusSyncIpc.Batch,new CloudSyncBatchCommand(b.BindingId,50)),CancellationToken.None);
+        Assert.Equal(IpcErrorCode.UnauthorizedClient,denied.Error!.Code);
+        var row=batch.Items[0];await h.RequestAsync<EmptyPayload>(FocusSyncIpc.Ack,new CloudSyncAckCommand(b.BindingId,[new(row.OperationId,row.RecordId,"applied",1,null)]));
+        Assert.Equal(1,(await h.RequestAsync<CloudSyncStatus>(FocusSyncIpc.Status,new CloudSyncBindingCommand(b.BindingId))).Uploaded);
+    }
+    [Fact]
+    public async Task NormalCompletionRecoverySurvivesDisconnectedServiceAndNewRecoveryInstance()
+    {
+        await using var h=new FocusSyncHarness();var path=Path.Combine(h.DirectoryPath,"recovery");
+        var recovery=new LocalFocusRecordRecovery(h.Connection,path,false);
+        var s=FocusSyncHarness.Record(Guid.Empty);var dto=new LocalFocusSessionDto(s.SessionId,LocalFocusSessionStatusDto.Completed,false,s.ConfiguredSeconds,s.ActualSeconds,
+            s.PreparationStartedAtUtc,s.FocusStartedAtUtc,s.PlannedEndAtUtc,s.CompletedAtUtc,FocusCompletionKindDto.Natural,s.TargetId,s.TargetNameSnapshot,false,null,null,[]){CloudBindingId=Guid.Empty};
+        await recovery.SaveAsync(dto);Assert.True(recovery.HasWarning);Assert.Single(Directory.GetFiles(path,"*.json"));
+        await h.ConnectAsync();var restarted=new LocalFocusRecordRecovery(h.Connection,path,false);await restarted.FlushAsync();
+        Assert.Empty(Directory.GetFiles(path,"*.json"));Assert.Equal(dto.SessionId,Assert.Single((await h.Store.LoadAsync()).FocusSessions).SessionId);
+        Assert.False(restarted.HasWarning);
+    }
+    [Fact]
+    public async Task ForcedNaturalCompletionUsesSameAtomicOutboxPath()
+    {
+        await using var h=new FocusSyncHarness();var b=await h.RequestAsync<CloudSyncBinding>(FocusSyncIpc.Bind,new CloudSyncBindCommand(Guid.NewGuid(),new string('A',64)));
+        var started=await h.RequestAsync<FocusSessionMutationResult>(IpcOperations.StartForcedFocus,new StartForcedFocusCommand(60,null,null,[],CloudBindingId:b.BindingId));
+        h.Advance(TimeSpan.FromSeconds(70));
+        using var timeout=new CancellationTokenSource(TimeSpan.FromSeconds(10));
+        while(!(await h.Store.LoadAsync()).FocusSessions.Any(x=>x.Status==LocalFocusSessionStatus.Completed))await Task.Delay(30,timeout.Token);
+        var item=Assert.Single(await h.Store.ReadFocusUploadBatchAsync(b.BindingId,50));
+        Assert.True(Assert.Single((await h.Store.LoadAsync()).FocusSessions).IsForcedMode);Assert.Contains("\"actualSeconds\":60",item.PayloadJson);
+    }
+    [Fact]
+    public async Task CorruptRecoveryFileIsPreserved_AndDoesNotBlockValidRecord()
+    {
+        await using var h=new FocusSyncHarness();var folder=Path.Combine(h.DirectoryPath,"recovery");Directory.CreateDirectory(folder);
+        File.WriteAllText(Path.Combine(folder,"corrupt.json"),"incomplete");await h.ConnectAsync();
+        var recovery=new LocalFocusRecordRecovery(h.Connection,folder,false);var s=FocusSyncHarness.Record(Guid.Empty);
+        var dto=new LocalFocusSessionDto(s.SessionId,LocalFocusSessionStatusDto.Completed,false,1500,1500,s.PreparationStartedAtUtc,s.FocusStartedAtUtc,s.PlannedEndAtUtc,s.CompletedAtUtc,FocusCompletionKindDto.Natural,null,null,false,null,null,[]);
+        await recovery.SaveAsync(dto);Assert.Single((await h.Store.LoadAsync()).FocusSessions);
+        Assert.Single(Directory.GetFiles(folder,"*.invalid.*"));Assert.True(recovery.HasWarning);
+    }
