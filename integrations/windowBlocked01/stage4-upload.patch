+            var challenge=await cloud.SendCodeAsync(email,false);var message=Directory.GetFiles(mail,"*.eml").Select(File.ReadAllText).Single(x=>x.Contains(email,StringComparison.OrdinalIgnoreCase));
+            var separator=message.IndexOf("\r\n\r\n",StringComparison.Ordinal);var body=message[(separator+4)..].Trim();
+            if(message[..separator].Contains("base64",StringComparison.OrdinalIgnoreCase))body=Encoding.UTF8.GetString(Convert.FromBase64String(body));
+            await cloud.RegisterAsync(email,challenge.ChallengeId,Regex.Match(body,"[0-9]{6}").Value,"UploadClient123");
+        }
+        async Task<HttpResponseMessage> Read(Guid id)
+        {
+            using var request=new HttpRequestMessage(HttpMethod.Get,"api/v1/focus-records/"+id);
+            request.Headers.Authorization=new("Bearer",vault.Load().Tokens!.AccessToken);return await http.SendAsync(request);
+        }
+        var guest=FocusSyncHarness.Record(Guid.Empty);await h.Store.SaveFocusSessionAsync(guest);
+        await Register(a);await cloud.LoginAsync(a,"UploadClient123");
+        var worker=new FocusUploadCoordinator(h.Connection,cloud,false);await worker.TickAsync();
+        Assert.True(worker.CanPrepareImport);Assert.Equal(HttpStatusCode.NotFound,(await Read(guest.SessionId)).StatusCode);
+        var normal=FocusSyncHarness.Record(h.Connection.CloudBindingId);
+        LocalFocusSessionDto Dto(bool complete)=>new(normal.SessionId,complete?LocalFocusSessionStatusDto.Completed:LocalFocusSessionStatusDto.Focusing,false,
+            normal.ConfiguredSeconds,complete?normal.ActualSeconds:0,normal.PreparationStartedAtUtc,normal.FocusStartedAtUtc,normal.PlannedEndAtUtc,
+            complete?normal.CompletedAtUtc:null,complete?FocusCompletionKindDto.Natural:null,normal.TargetId,normal.TargetNameSnapshot,false,null,null,
+            [new("task","任务",0){CompletedAtUtc=normal.CompletedAtUtc,Details=new("说明",[new("步骤",true)])}]);
+        await h.Connection.StartNormalFocusAsync(Dto(false));await h.Connection.RecordCompletedFocusAsync(Dto(true));
+        var pending=Assert.Single(await h.Store.ReadFocusUploadBatchAsync(h.Connection.CloudBindingId,50));
+        Assert.Equal(pending.OperationId,Assert.Single(await new SqliteLocalDataStore(h.DatabasePath).ReadFocusUploadBatchAsync(h.Connection.CloudBindingId,50)).OperationId);
+        handler.LoseNext=true;await worker.TickAsync();Assert.Contains("待上传 1",worker.Summary);
+        Assert.Equal(HttpStatusCode.OK,(await Read(normal.SessionId)).StatusCode);
