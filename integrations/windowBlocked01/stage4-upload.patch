+        public LoseResponseHandler():base(new HttpClientHandler{AllowAutoRedirect=false}){}
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request,CancellationToken ct)
+        {
+            var upload=request.RequestUri!.AbsolutePath.EndsWith("/focus-records/push");
