+        {CloudBindingId=s.CloudBindingId};
+
+    [LiveAccountFact]
+    public async Task TwoIndependentDevices_DownloadDeleteRetryAndSwitchAccountsWithoutResurrectionOrTaskSideEffects()
+    {
+        await using var a=new FocusSyncHarness();await using var b=new FocusSyncHarness();await a.ConnectAsync();await b.ConnectAsync();
+        var endpoint=new Uri(Environment.GetEnvironmentVariable("FOCUSTIME_TEST_API")!);
+        var mail=Environment.GetEnvironmentVariable("FOCUSTIME_TEST_MAIL")!;
+        using var httpA=new HttpClient{BaseAddress=endpoint};var networkB=new Network();using var httpB=new HttpClient(networkB){BaseAddress=endpoint};
+        var vaultA=new WindowsCredentialStore(endpoint,Path.Combine(a.DirectoryPath,"credentials"));
+        var vaultB=new WindowsCredentialStore(endpoint,Path.Combine(b.DirectoryPath,"credentials"));
+        var cloudA=new CloudAccountClient(httpA,vaultA);var cloudB=new CloudAccountClient(httpB,vaultB);
+        const string password="BiSyncClient123";
+        var email="bidirectional-"+Guid.NewGuid().ToString("N")+"@example.test";
+        async Task Register(CloudAccountClient cloud,string address)
+        {
+            var challenge=await cloud.SendCodeAsync(address,false);
+            var message=Directory.GetFiles(mail,"*.eml").Select(File.ReadAllText).Single(x=>x.Contains(address,StringComparison.OrdinalIgnoreCase));
+            var separator=message.IndexOf("\r\n\r\n",StringComparison.Ordinal);var body=message[(separator+4)..].Trim();
+            if(message[..separator].Contains("base64",StringComparison.OrdinalIgnoreCase))body=Encoding.UTF8.GetString(Convert.FromBase64String(body));
+            await cloud.RegisterAsync(address,challenge.ChallengeId,Regex.Match(body,"[0-9]{6}").Value,password);
+        }
+        async Task<HttpResponseMessage> Read(CloudAccountClient cloud,HttpClient http,WindowsCredentialStore vault,Guid id)
+        {
+            Assert.NotNull(await cloud.GetUploadIdentityAsync());
+            using var request=new HttpRequestMessage(HttpMethod.Get,"api/v1/focus-records/"+id);
+            request.Headers.Authorization=new AuthenticationHeaderValue("Bearer",vault.Load().Tokens!.AccessToken);
+            return await http.SendAsync(request);
+        }
+        await Register(cloudA,email);await cloudA.LoginAsync(email,password);await cloudB.LoginAsync(email,password);
