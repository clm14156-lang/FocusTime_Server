+
+public sealed class CloudBidirectionalLiveTests
+{
+    private sealed class Network : DelegatingHandler
+    {
+        public Network():base(new HttpClientHandler{AllowAutoRedirect=false}){}
+        public bool LoseNextDelete {get;set;}
+        public bool BlockDownloads {get;set;}
+        public List<(Guid OperationId,string Kind)> Attempts {get;}=[];
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request,CancellationToken ct)
+        {
+            if(BlockDownloads&&request.RequestUri!.AbsolutePath.EndsWith("/focus-records/changes"))throw new HttpRequestException("Offline download");
+            var deleting=false;
+            if(request.RequestUri!.AbsolutePath.EndsWith("/focus-records/push"))
+            {
+                using var body=JsonDocument.Parse(await request.Content!.ReadAsStringAsync(ct));
+                foreach(var item in body.RootElement.GetProperty("operations").EnumerateArray())
+                {var kind=item.GetProperty("kind").GetString()!;Attempts.Add((item.GetProperty("operationId").GetGuid(),kind));deleting|=kind=="delete";}
+            }
+            var response=await base.SendAsync(request,ct);
+            if(deleting&&LoseNextDelete&&response.IsSuccessStatusCode)
+            {LoseNextDelete=false;response.Dispose();throw new HttpRequestException("Lost committed deletion response");}
+            return response;
+        }
+    }
+
+    private static LocalFocusSessionDto Dto(LocalFocusSession s)=>new(s.SessionId,LocalFocusSessionStatusDto.Completed,
